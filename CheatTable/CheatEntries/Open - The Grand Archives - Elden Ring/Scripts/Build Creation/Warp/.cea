{$lua}
if syntaxcheck then return end
[ENABLE]
if lua_warp == nil then
    getAddressList().getMemoryRecordByDescription("Warp_code").active = true
    throwError("'lua_warp' symbol was not found.\nTry enabling this script again.")
end

