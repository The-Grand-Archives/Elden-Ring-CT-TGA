{$lua}
if syntaxcheck then return end
[ENABLE]
cfgForm = uiBase:new(memrec)

function cfgForm:configure()
	local checkBoxes = self.ctrl
	local config = tga.config
	for i,v in pairs(config) do
		local desc = tga.configdesc[i]
		config[i] = checkBoxes[desc:gsub("%s+", "")].Checked
	end
	tga:saveConfig()
	self.Window.close()
end

function cfgForm:createWindow()
	local formName = 'ConfigureTable'
	self.Window = self:create('TCEForm', nil, {
		Caption = 'Configure Table',
	}, formName)

	self:create('TLabel', formName, {Caption = '', Left = 15})
	self:create('TScrollBox', formName, {
		Caption = 'test',
		Width = 300,
		Height = 110,
		Left = 10,
		Top = 15,
		ChildSizing = {
			Layout = 'cclLeftToRightThenTopToBottom',
			EnlargeHorizontal = 'crsScaleChilds',
			LeftRightSpacing = 5,
		}
	})
	for i,v in pairs(tga.config) do
		if type(v) == "boolean" then
			self:create('TCheckBox', 'test', {Caption = tga.configdesc[i], Checked = v})
		end
	end
	self:create('TButton', formName, {
		Caption = 'OK',
		Width = self.ctrl[formName].Width - 20,
		Height = 40,
		Left = 10,
		Top = self.ctrl['test'].y + 10,
		OnClick = function() self:configure() end
	})
	self:fixSize(formName, 10, 10)
	self:applyScaling()
end

cfgForm.Main = cfgForm:new()
cfgForm.Main:createWindow()

[DISABLE]
pcall(cfgForm.Main.Window.destroy)
cfgForm = nil